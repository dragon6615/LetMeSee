<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <StartupObject>LetMeSee.Program</StartupObject>
    <!-- 只維護這一個版本欄位；FileVersion 與 AssemblyVersion 由它衍生。
         CI 發佈時會用 tag 覆寫（-p:Version=...），所以 tag 才是正式版的版本來源。 -->
    <Version>1.2.1</Version>
    <Authors>Dragon Huang</Authors>
    <Company>Dragon Huang</Company>
    <Copyright>Dragon Huang</Copyright>
    <Description>QuickView Windows Support Picture</Description>
    <Product>LetMeSee</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>
