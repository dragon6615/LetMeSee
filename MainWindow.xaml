<Window x:Class="LetMeSee.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LetMeSee"
        Icon="Assets/AppIcon.ico"
        Width="960"
        Height="640"
        MinWidth="160"
        MinHeight="120"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
    <Grid>
        <DockPanel>
            <Menu x:Name="MainMenu"
                  DockPanel.Dock="Top"
                  Background="#E8E8E8"
                  Foreground="#111111"
                  FontSize="16">
                <MenuItem Header="檔案(_F)">
                    <MenuItem Header="開啟(_O)..." InputGestureText="Ctrl+O" Click="OpenMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="離開(_X)" Click="ExitMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="檢視(_V)">
                    <MenuItem Header="實際大小(_A)" InputGestureText="/" Click="ActualSizeMenuItem_Click" />
                    <MenuItem Header="符合視窗大小(_W)" InputGestureText="*" Click="FitToWindowMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="全螢幕(_F)" InputGestureText="F" Click="FullScreenMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="設定(_S)">
                    <MenuItem Header="檔案關聯(_A)..."
                              Click="FileAssociationsMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="說明(_H)">
                    <MenuItem Header="開啟診斷紀錄(_L)" Click="OpenDiagnosticLogMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="關於(_B)" Click="AboutMenuItem_Click" />
                </MenuItem>
            </Menu>

            <Border x:Name="Viewport"
                    Background="#000000"
                    ClipToBounds="True"
                    Focusable="True"
                    FocusVisualStyle="{x:Null}"
                    MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                    MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                    MouseMove="Viewport_MouseMove"
                    MouseWheel="Viewport_MouseWheel"
                    SizeChanged="Viewport_SizeChanged">
                <Border.ContextMenu>
                    <ContextMenu Opened="ViewportContextMenu_Opened">
                        <MenuItem Header="開啟檔案(_O)..." InputGestureText="Ctrl+O" Click="OpenMenuItem_Click" />
                        <Separator />
                        <MenuItem x:Name="SaveAsContextMenuItem"
                                  Header="另存新檔(_A)..."
                                  Click="SaveAsMenuItem_Click" />
                        <Separator />
                        <MenuItem x:Name="SetDefaultProgramContextMenuItem"
                                  Header="設為預設開啟程式..."
                                  Click="SetDefaultProgramMenuItem_Click" />
                        <Separator />
                        <MenuItem x:Name="RotateLeftContextMenuItem"
                                  Header="向左旋轉 90 度(_L)"
                                  Click="RotateLeftMenuItem_Click" />
                        <MenuItem x:Name="RotateRightContextMenuItem"
                                  Header="向右旋轉 90 度(_R)"
                                  Click="RotateRightMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="離開(_X)" Click="ExitMenuItem_Click" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Canvas x:Name="ImageCanvas">
                        <Image x:Name="ImageView"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />
                    </Canvas>

                    <TextBlock x:Name="MessageText"
                               Margin="18"
                               MaxWidth="680"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FFFFFF"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="ImageInfoText"
                               Margin="16"
                               MaxWidth="760"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Background="#B0000000"
                               Foreground="#FFFF3030"
                               FontSize="16"
                               FontWeight="Bold"
                               IsHitTestVisible="False"
                               Padding="8"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
