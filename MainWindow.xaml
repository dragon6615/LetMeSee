<Window x:Class="LetMeSee.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LetMeSee"
        Icon="Assets/AppIcon.ico"
        Width="960"
        Height="640"
        MinWidth="160"
        MinHeight="120"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">
    <Grid>
        <DockPanel>
            <Menu x:Name="MainMenu"
                  DockPanel.Dock="Top"
                  Visibility="Collapsed"
                  Background="#E8E8E8"
                  Foreground="#111111"
                  FontSize="16">
                <MenuItem Header="_File">
                    <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="OpenMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Actual Size" InputGestureText="/" Click="ActualSizeMenuItem_Click" />
                    <MenuItem Header="_Fit to Window" InputGestureText="*" Click="FitToWindowMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="_Full Screen" InputGestureText="F" Click="FullScreenMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="_Setup">
                    <MenuItem x:Name="FileAssociationsMenuItem"
                              Header="檔案關聯"
                              IsCheckable="True"
                              Click="FileAssociationsMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_About" Click="AboutMenuItem_Click" />
                </MenuItem>
            </Menu>

            <Border x:Name="Viewport"
                    Background="#000000"
                    ClipToBounds="True"
                    Focusable="True"
                    FocusVisualStyle="{x:Null}"
                    MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                    MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                    MouseMove="Viewport_MouseMove"
                    MouseWheel="Viewport_MouseWheel"
                    SizeChanged="Viewport_SizeChanged">
                <Border.ContextMenu>
                    <ContextMenu Opened="ViewportContextMenu_Opened">
                        <MenuItem Header="_Open File..." InputGestureText="Ctrl+O" Click="OpenMenuItem_Click" />
                        <Separator />
                        <MenuItem x:Name="SaveAsContextMenuItem"
                                  Header="Save _As..."
                                  Click="SaveAsMenuItem_Click" />
                        <Separator />
                        <MenuItem x:Name="RotateLeftContextMenuItem"
                                  Header="Turn Left 90°"
                                  Click="RotateLeftMenuItem_Click" />
                        <MenuItem x:Name="RotateRightContextMenuItem"
                                  Header="Turn Right 90°"
                                  Click="RotateRightMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Canvas x:Name="ImageCanvas">
                        <Image x:Name="ImageView"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />
                    </Canvas>

                    <TextBlock x:Name="MessageText"
                               Margin="18"
                               MaxWidth="680"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FFFFFF"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="ImageInfoText"
                               Margin="16"
                               MaxWidth="760"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Background="#B0000000"
                               Foreground="#FFFF3030"
                               FontSize="16"
                               FontWeight="Bold"
                               IsHitTestVisible="False"
                               Padding="8"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Window>
